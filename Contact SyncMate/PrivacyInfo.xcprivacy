<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No ATT-style tracking: api.anthropic.com / googleapis.com are
	     first-party functional endpoints, not tracking domains. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Matches the App Store "Data Not Collected" label: contact data is
	     exchanged with Google (the sync itself) and, only with explicit
	     user consent, Anthropic (AI duplicate matching); the developer
	     collects nothing. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: app's own settings and sync state. -->
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: timestamps of files inside the app container
				     (backup retention/pruning). -->
				<string>C617.1</string>
				<!-- DDA9.1: backup dates displayed to the user in the
				     backup list. -->
				<string>DDA9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
