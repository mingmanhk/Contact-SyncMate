    "A safety snapshot of the current state is taken first, so this restore can itself be undone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统会先为目前状态建立安全快照,因此这次还原本身也可以复原。"
