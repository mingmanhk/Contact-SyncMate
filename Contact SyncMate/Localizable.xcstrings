          }
        }
      }
    },
    "View Full Details": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視完整詳細資料"
          }
        }
      }
    },
    "View History & Backups": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視記錄與備份"
          }
        }
      }
    },
    "Welcome to Contact SyncMate": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎使用 Contact SyncMate"
          }
        }
      }
    },
    "What will happen": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來會發生什麼"
          }
        }
      }
    },
    "When enabled, Contact SyncMate won't appear in the Dock": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後,Contact SyncMate 不會出現在 Dock 中"
          }
        }
      }
    },
    "Which Claude model analyses borderline duplicate pairs": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由哪個 Claude 模型分析難以判定的重複配對"
          }
        }
      }
    },
    "Wider range = more API calls and higher accuracy; narrower = fewer calls and lower cost.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範圍越寬 = API 呼叫越多、準確度越高;越窄 = 呼叫越少、成本越低。"
          }
        }
      }
    },
    "Write every contact even if it appears unchanged": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使聯絡人看起來沒有變動,也一律寫入"
          }
        }
      }
    },
    "You can always change this later in Preferences.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以在「設定」中更改。"
          }
        }
      }
    },
    "Your Mac doesn't have any contacts accounts configured": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Mac 尚未設定任何聯絡人帳號"
          }
        }
      }
    },
    "Your contacts stay on your device. No third-party servers are involved.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聯絡人只留在你的裝置上,不經過任何第三方伺服器。"
          }
        }
      }
    },
    "Your decision:": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的決定："
          }
        }
      }
    },
