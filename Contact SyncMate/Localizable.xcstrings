    },
    "When enabled, Contact SyncMate won't appear in the Dock": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后,Contact SyncMate 不会出现在 Dock 中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後,Contact SyncMate 不會出現在 Dock 中"
          }
        }
      }
    },
    "Which Claude model analyses borderline duplicate pairs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由哪个 Claude 模型分析难以判定的重复配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由哪個 Claude 模型分析難以判定的重複配對"
          }
        }
      }
    },
    "Wider range = more API calls and higher accuracy; narrower = fewer calls and lower cost.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围越宽 = API 呼叫越多、准确度越高;越窄 = 呼叫越少、成本越低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範圍越寬 = API 呼叫越多、準確度越高;越窄 = 呼叫越少、成本越低。"
          }
        }
      }
    },
    "Write every contact even if it appears unchanged": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使联系人看起来没有变动,也一律写入"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使聯絡人看起來沒有變動,也一律寫入"
          }
        }
      }
    },
    "You can always change this later in Preferences.": {
      "localizations": {
